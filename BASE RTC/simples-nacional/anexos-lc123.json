{
  "versao": "1.0.0",
  "atualizadoEm": "2026-08-10",
  "descricao": "Tabelas dos Anexos I a V do Simples Nacional: faixas de RBT12, alíquota nominal, parcela a deduzir e repartição dos tributos dentro do DAS. Base para calcular alíquota efetiva e desmembrar o DAS por tributo.",
  "fonte": {
    "normativa": "LC 123/2006, art. 18 e Anexos I a V (redação da LC 155/2016)",
    "referenciaOperacional": "Simulador Guerra RTC — sn-transicao (constante FAIXAS) e dominando-simples (motor-sn.js)",
    "confianca": "alta"
  },
  "formulas": {
    "aliquotaEfetiva": {
      "expressao": "((RBT12 * aliquotaNominal) - parcelaDeduzir) / RBT12",
      "resultado": "percentual efetivo aplicado sobre a receita bruta do mês",
      "fundamento": "LC 123/2006, art. 18, § 1º-A"
    },
    "valorDas": {
      "expressao": "receitaBrutaMes * aliquotaEfetiva",
      "observacao": "Receita do mês, não a receita acumulada. O RBT12 serve apenas para achar a faixa."
    },
    "reparticaoTributo": {
      "expressao": "valorDas * (percentualDoTributoNaFaixa / 100)",
      "observacao": "A soma dos percentuais de repartição de cada faixa é 100%."
    },
    "rbt12": {
      "expressao": "soma da receita bruta dos 12 meses anteriores ao período de apuração",
      "inicioAtividade": "Nos 12 primeiros meses, proporcionalizar: média da receita dos meses de atividade × 12.",
      "fundamento": "LC 123/2006, art. 3º, § 2º e art. 18, §§ 1º e 2º"
    }
  },
  "tributos": {
    "irpj": "Imposto de Renda da Pessoa Jurídica",
    "csll": "Contribuição Social sobre o Lucro Líquido",
    "cofins": "COFINS — substituída pela CBS no cronograma da Reforma",
    "pis": "PIS/PASEP — substituído pela CBS no cronograma da Reforma",
    "cpp": "Contribuição Patronal Previdenciária",
